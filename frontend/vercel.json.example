{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND-NAME.onrender.com/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://YOUR-BACKEND-NAME.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://YOUR-BACKEND-NAME.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
